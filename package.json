{
  "name": "yidaai",
  "version": "3.0.0",
  "description": "宜搭AI助手 - 一条命令安装、增量更新、多工具适配",
  "main": "lib/index.js",
  "bin": {
    "yida-helper": "bin/cli.js",
    "yidaazs": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    ".agents/skills/",
    "templates/",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "validate:write": "node scripts/precommit-validate.js --all",
    "validate:staged": "node scripts/precommit-validate.js --staged",
    "install:playwright": "npx playwright install chromium",
    "validate:skills": "node scripts/validate-skill-config.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "jest --coverage --coverageReporters=text-summary && node .agents/skills/integration/scripts/integration-builder.test.js",
    "test:integration-builder": "node .agents/skills/integration/scripts/integration-builder.test.js",
    "test:core": "jest tests/core/ --coverage --coverageReporters=text-summary",
    "test:features": "jest tests/features/"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "axios": "^1.14.0",
    "uglify-js": "^3.19.3",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
