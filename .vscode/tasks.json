{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动宜搭同步服务",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/.trae/skills/form_creator/scripts/sync_server.js"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "启动原型页面服务器",
      "type": "shell",
      "command": "npx",
      "args": [
        "http-server",
        "${workspaceFolder}/进销存管理/01需求梳理/原型页面",
        "-p",
        "8080",
        "-o"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
